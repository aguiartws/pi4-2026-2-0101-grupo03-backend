# Copie este arquivo para .env e ajuste se precisar:
#   cp .env.example .env
# O .env NÃO vai para o Git. Se um valor não estiver definido,
# o docker-compose.yml usa o padrão indicado nele.

# Porta da API na sua máquina (http://localhost:8081)
API_PORT=8081

# Porta do PostgreSQL na sua máquina.
# Mude se você já tem um Postgres local usando a 5432.
DB_PORT=5432

DB_NAME=finduhouse
DB_USER=finduhouse
DB_PASSWORD=finduhouse
